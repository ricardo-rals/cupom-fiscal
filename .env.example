POSTGRES_USER=cupom
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cupom

# Sem chave, os itens novos vao direto para a fila de revisao.
GEMINI_API_KEY=
LLM_LIMITE_MENSAL_USD=5
NORMALIZACAO_LIMIAR=0.8

# Senha do papel somente leitura do agente de perguntas; sem ela, o agente fica desligado.
# Use letras e numeros: ela entra numa URL de conexao.
AGENT_RO_PASSWORD=

# Login Google. Crie o cliente OAuth em console.cloud.google.com, tipo Web, com o redirect
# http://localhost:3000/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Gere cada uma com: openssl rand -base64 32
AUTH_SECRET=
# Assina as chamadas do web para a api; sem ela a api recusa tudo.
API_TOKEN_SECRET=
# O primeiro login com este e-mail fica com os cupons de antes do login.
OWNER_EMAIL=
